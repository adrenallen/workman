{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workman-r2-prune",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "workman-releases",
      "remote": true
    }
  ]
}
