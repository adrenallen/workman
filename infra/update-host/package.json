{
  "name": "@workman/update-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "manifest": "node scripts/generate-manifest.mjs",
    "prune": "node scripts/prune-releases.mjs",
    "promote": "node scripts/publish-release.mjs promote",
    "publish": "node scripts/publish-release.mjs",
    "test": "node --test test/*.test.mjs",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
