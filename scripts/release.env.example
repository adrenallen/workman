# Copy to ~/.workman-release.env and keep that file outside the repository.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_TEAM_ID="TEAMID"
APPLE_API_KEY_PATH="/absolute/path/to/.appstoreconnect/private_keys/AuthKey_KEYID.p8"
APPLE_API_KEY="KEYID"
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"

# Optional: notarytool's single blocking wait timeout. The default is 2h.
# WORKMAN_NOTARY_TIMEOUT="3h"
